#!/bin/sh
# 提交前钩子：阻止疑似 API Key 的文件进入仓库
# 启用方式（仅提示，未自动执行）：git config core.hooksPath .githooks

for file in $(git diff --cached --name-only --diff-filter=ACM); do
  # 示例文件不含真实密钥，跳过
  case "$file" in
    *.env.example) continue ;;
  esac

  # -I 跳过二进制文件，q 静默；命中即拦截
  if grep -IqE 'sk-[A-Za-z0-9_-]{16,}|DEEPSEEK_API_KEY[[:space:]]*=[[:space:]]*[^[:space:]]+' "$file"; then
    echo "[pre-commit] 检测到疑似 API Key，已阻止提交：$file"
    exit 1
  fi
done

exit 0
