# Python 虚拟环境
backend/.venv/
__pycache__/
# 其它位置（仓库根目录 / frontend 等）的虚拟环境
.venv/
venv/

# 数据库文件
backend/data/

# 环境变量（可能包含 API Key）
backend/.env

# 前端依赖与构建产物
node_modules/
dist/

# 日志与操作系统文件
*.log
.runtime/
.DS_Store

# 本地文档缓存
.trae/documents/
.screenshots/
.pytest_cache/

#参考文档
Reference_Doc/

# 任何环境变量文件（保留示例）
.env
.env.*
!.env.example

# 数据库文件
*.db
*.sqlite
*.sqlite3

# SQLite 运行时附属文件（WAL / 共享内存），随数据库一起产生
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm

# 密钥/证书
*.key
*.pem

#Trae 相关文件
.trae/
.documents/
.screenshots/
.pytest_cache/
.githooks/
.vscode/

