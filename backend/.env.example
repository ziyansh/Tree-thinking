# DeepSeek API Key（必填）——前往 https://platform.deepseek.com/api_keys 申请后填入
DEEPSEEK_API_KEY=

# DeepSeek 接口地址（OpenAI 兼容协议）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 使用的模型名称，可改为 deepseek-v4-pro 等
DEEPSEEK_MODEL=deepseek-flash

# OpenAI 配置（在「设置 → 模型服务」中选择 OpenAI 时生效；也可直接填入此处兜底）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 是否开启思考模式（true / false）
THINKING_ENABLED=true

# 每个节点生成的候选方向数量（建议 2-6）
SUGGESTION_COUNT=3

# SQLite 数据库路径，相对路径按仓库根目录解析
DB_PATH=backend/data/app.db

# 运行模式：local（本地单用户，免登录）/ server（服务器多用户，需注册登录）
APP_MODE=local

# 会话签名密钥，server 模式必填，使用强随机字符串
AUTH_SECRET=

# 会话 Cookie 是否仅通过 HTTPS 发送（服务器启用 HTTPS 时保持 true）
AUTH_COOKIE_SECURE=true

# 允许访问后端的前端来源，多个用逗号分隔
ALLOWED_ORIGINS=http://localhost:5173
