# DeepSeek API Key（必填）——前往 https://platform.deepseek.com/api_keys 申请后填入
DEEPSEEK_API_KEY=

# DeepSeek 接口地址（OpenAI 兼容协议）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 使用的模型名称，可改为 deepseek-v4-pro 等
DEEPSEEK_MODEL=deepseek-flash

# OpenAI 配置（在「设置 → 模型服务」中选择 OpenAI 时生效；也可直接填入此处兜底）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 是否开启思考模式（true / false）
THINKING_ENABLED=true

# 每个节点生成的候选方向数量（建议 2-6）
SUGGESTION_COUNT=3

# SQLite 数据库路径，相对路径按仓库根目录解析
DB_PATH=backend/data/app.db
